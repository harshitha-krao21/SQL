--a) add constraint pk key on eid column,unique on name column,check on salary columnn that non negative or zero salary can be inserted 
DECLARE @EmpTable TABLE
(eid INT PRIMARY KEY,         
name VARCHAR(50) UNIQUE,     
salary DECIMAL(10,2) CHECK (salary > 0));


--b)insert data from emp table  
