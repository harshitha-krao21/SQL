--1) declare table variable and insert all records from humanresources.employee table,  
--a)delete odd records 
--b)update even records jobtitle to 'manager. 
DECLARE @EmployeeTable TABLE
(
    RowNum INT,
    NationalIDNumber NVARCHAR(15),
    BusinessEntityID INT,
    LoginID NVARCHAR(256),
    OrganizationNode HIERARCHYID,
    OrganizationLevel SMALLINT,
    JobTitle NVARCHAR(50),
    BirthDate DATE,
    MaritalStatus NCHAR(1),
    Gender NCHAR(1),
    HireDate DATE,
    SalariedFlag BIT,
    VacationHours SMALLINT,
    SickLeaveHours SMALLINT,
    CurrentFlag BIT
);

INSERT INTO @EmployeeTable
SELECT
    ROW_NUMBER() OVER (ORDER BY BusinessEntityID) AS RowNum,
    NationalIDNumber,
    BusinessEntityID,
    LoginID,
    OrganizationNode,
    OrganizationLevel,
    JobTitle,
    BirthDate,
    MaritalStatus,
    Gender,
    HireDate,
    SalariedFlag,
    VacationHours,
    SickLeaveHours,
    CurrentFlag
FROM HumanResources.Employee;

--a)delete odd records 

DELETE
FROM @EmployeeTable
WHERE RowNum % 2 = 1;

--b)update even records jobtitle to 'manager. 
UPDATE @EmployeeTable
SET JobTitle = 'Manager'
WHERE RowNum % 2 = 0;
 

