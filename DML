--1. Create employees table
CREATE TABLE employees (
    employee_number INT,
    last_name VARCHAR(50),
    first_name VARCHAR(50),
    salary DECIMAL(10, 2),
    dept_id INT
);
--2. Insert all records
INSERT INTO employees (employee_number, last_name, first_name, salary, dept_id) VALUES
(1001, 'Smith', 'John', 62000.00, 500),
(1002, 'Anderson', 'Jane', 57500.00, 500),
(1003, 'Everest', 'Brad', 71000.00, 501),
(1004, 'Horvath', 'Jack', 42000.00, 501);

--3. Insert two new records
INSERT INTO employees (employee_number, first_name, salary) VALUES
(1005, 'Mary', 47500.00);

INSERT INTO employees (employee_number, last_name, salary) VALUES
(1006, 'William', 32000.00);

-- OR as a single statement with all columns (though values will be NULL for missing fields)
INSERT INTO employees (employee_number, last_name, first_name, salary, dept_id) VALUES
(1005, NULL, 'Mary', 47500.00, NULL),
(1006, 'William', NULL, 32000.00, NULL);

--4. Update all salaries by 20 percent
UPDATE employees
SET salary = salary * 1.20;

--5. Delete all records for dept_id of 501
DELETE FROM employees
WHERE dept_id = 501;


SELECT DISTINCT employee_number, last_name, first_name, salary, dept_id
FROM employees;


