
CREATE TABLE hospital_billing ( 

    patient_id INT PRIMARY KEY, 

    patient_name NVARCHAR(100), 

    admission_date DATE, 

    discharge_date DATE, 

    total_amount DECIMAL(10, 2), 

    insurance_coverage DECIMAL(10, 2), 

    payment_status NVARCHAR(50), 

    room_type NVARCHAR(50), 

    doctor_name NVARCHAR(100), 

    nurse_name NVARCHAR(100) 

); 



select * from hospital_billing;
----------
--Retrieve the patient_id and patient_name for all records in the hospital billing dataset. 
select patient_id, patient_name
from hospital_billing;

--List the patient_id, total_fee, and date_of_admission for patients who have been admitted after '2024-07-15'.
select patient_id, total_amount, admission_date
from hospital_billing
where admission_date > '2024-07-15';

--Display the patient_id, patient_name, and doctor's_name for patients who have 'Dr. Wilson' as their doctor.
select patient_id, patient_name, doctor_name
from hospital_billing
where doctor_name = 'Dr. Wilson';

----Find the patient_id and total_fee for patients whose total_fee is greater than $7000.
