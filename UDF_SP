Input- amount above which we want orders

Orders-orderid, custid, amount
-------
create function dbo.fn_high_value_orders
(
    @minamount decimal(10,2)
)
returns table
as
return
(
    select
        o.orderid,
        o.custid,
        o.amount,
        o.region
    from orders o
    join regions r
        on o.region = r.region
    where
        o.amount > @minamount
        and r.region_status = 'active'
);

