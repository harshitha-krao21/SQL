create procedure emp
(@ename varchar(50), @dept varchar(50), @minsalary decimal(5,2), @maxsalary decimal(8,2))
as
begin
    set nocount on;
select empid, ename, dept, salary
from employee
where (@ename is null or ename like '%' + @ename + '%')
and (@dept is null or dept = @dept)
and (@minsalary is null or salary >= @minsalary)
and (@maxsalary is null or salary <= @maxsalary)
order by ename;
end;

