create procedure dbo.sp_nth_highest_top
(
    @n int
)
as
begin
    set nocount on;

    -- Result table variable (optional)
    declare @Result table
    (
        id int,
        name varchar(50),
        salary int,
        dept varchar(50)
    );

    -- Loop through each department
    insert into @Result
    select e.id, e.name, e.salary, e.dept
    from emp e
    where e.salary = 
    (
        select min(salary) 
        from
        (
            select top (@n) salary
            from emp e2
            where e2.dept = e.dept
            order by salary desc
        ) as top_salaries
    );

    -- Return result
    select * from @Result;
end;



Customer Order Summary (E-Commerce)

Business Scenario

For each customer:

Total orders
Total amount
Average order value

Logic involves aggregation + calculation
 
Create a TVF to return customer order summary

customerid as input

table-order-ordered, customerid, orderamount

return summary of amount of orders for each customer
--------------
create function getSummary(@customerid int)
returns @ord table(customerid int, totalorders int, totalamount int, avgordervalue int)
as
begin

insert into @ord
select customerid, count(orderid) as totalorders, sum(orderamount) as totalamount, avg(orderamount) as avgordervalue
from order
where customerid = @customerid

end

