create function attendance(@empid int, @month int, @year int)
returns @res table(totalworkingdays int, presentdays int, absentdays int)
as
begin
insert into @res

select count(attendancedate) as totalworkingdays, 
count(case when status = 'present' then 1 else 0) as presentdays,
count(case when status = 'absent' then 1 else 0) as absentdays
from attendance
where empid = @eid and month(attendancedate) = @month and year(attendancedate) = @year



return
end

