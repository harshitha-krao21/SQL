Business Scenario

Bank system transfers money:

Debit one account
Credit another
Must handle failures safely

--ensure atomicity
--accid, name, balance
--------------------------------------------------------



create proc bank(@fromacctid int, @toacctid int, @amt int)
as
begin

set nocount on;
begin try
begin transaction

update accounts
set balance = balance - @amt
where accid = @fromacctid and balance > @amt

if @@rowcount = 0
begin
throw '50001,'Debit Failed',1'
end

update accounts
set balance = balance + @amt
where accid = @toacctid 

if @@rowcount = 0
begin
throw '50001,'Credit Failed',1'
end

commit;

end try

begin catch
if @@transactioncount > 0
rollback

throw
end catch

end










Scenario:
take integer input from user
create stored procedure to find the nth highest earning employee in each department using table variable

emp(id,name,salary,dept)
--------------------------

create procedure rnk(@n int)
as
begin

declare @RankEmp table
(id int,name varchar(50),salary int,dept varchar(50),salrank int);

insert into @RankEmp
select id,
       name,
       salary,
       dept,
       DENSE_RANK() over (partition by dept order by salary desc) as salrank
       from emp;

select id,
       name,
       salary,
       dept
       from @RankEmp
       where salrank = @n
end;
