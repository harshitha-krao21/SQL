create function dbo.sales(@amount int, @region varchar(30))
returns @res table(orderid int, custid int, amount int,region varchar(30))
as
begin
insert into @res
select o.orderid, o.custid, o.amount, i.region
from orders o
join inventory i
on i.orderid = o.orderid
where o.amount >= @amount and i.region = @region
return
end

