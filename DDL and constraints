    CourseID VARCHAR(20) NOT NULL,
    StudentID VARCHAR(20) NOT NULL,
    ExamDate DATE NOT NULL,
    Grade VARCHAR(2) NOT NULL,  -- Changed from CHAR to VARCHAR
    PRIMARY KEY (CourseID, StudentID, ExamDate),
    FOREIGN KEY (CourseID) REFERENCES COURSE(CourseID),
    CONSTRAINT CHK_Grade_NoC CHECK (Grade NOT LIKE 'C%')
);

