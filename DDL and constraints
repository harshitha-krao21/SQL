CREATE TABLE RANKING (
    StudentID VARCHAR(20) PRIMARY KEY,
    Average DECIMAL(5,2) NOT NULL CHECK (Average >= 50),
    Credits INT NOT NULL CHECK (Credits >= 0),
    StudentRank INT NOT NULL CHECK (StudentRank > 0)
);

