-- Create PRICINGPLAN table FIRST (CUSTOMER depends on it)
CREATE TABLE PRICINGPLAN (
    Code VARCHAR(20) PRIMARY KEY,
    ConnectionFee DECIMAL(10,2) NOT NULL,
    PricePerSecond DECIMAL(10,4) NOT NULL
);

-- Create CUSTOMER table (use brackets for reserved keyword 'Plan')
CREATE TABLE CUSTOMER (
    SSN VARCHAR(20) PRIMARY KEY,
    Name VARCHAR(50) NOT NULL,
    Surname VARCHAR(50) NOT NULL,
    PhoneNum VARCHAR(15) UNIQUE NOT NULL,
    [Plan] VARCHAR(20) NOT NULL,  -- Use brackets for reserved keyword
    FOREIGN KEY ([Plan]) REFERENCES PRICINGPLAN(Code)  -- Inline foreign key
);

-- Create PHONECALL table
CREATE TABLE PHONECALL (
    SSN VARCHAR(20) NOT NULL,
    [Date] DATE NOT NULL,  -- Date is also a reserved keyword
    [Time] TIME NOT NULL,  -- Time is a reserved keyword
    CalledNum VARCHAR(15) NOT NULL,
    Seconds INT NOT NULL,
    PRIMARY KEY (SSN, [Date], [Time]),
    FOREIGN KEY (SSN) REFERENCES CUSTOMER(SSN)
);

-- Create BILL table
CREATE TABLE BILL (
    SSN VARCHAR(20) NOT NULL,
    [Month] INT NOT NULL CHECK ([Month] BETWEEN 1 AND 12),  -- Month is reserved
    [Year] INT NOT NULL,
    Amount DECIMAL(10,2) NOT NULL,
    PRIMARY KEY (SSN, [Month], [Year]),
    FOREIGN KEY (SSN) REFERENCES CUSTOMER(SSN)
);

-- Note: Removed ALTER TABLE for Plan foreign key since it's now inline

-- Create TEAM table
CREATE TABLE TEAM (
    TeamName VARCHAR(50) PRIMARY KEY,
    Coach VARCHAR(100) NOT NULL,
    WonGames INT DEFAULT 0
);

-- Create PLAYER table
CREATE TABLE PLAYER (
    PlayerId INT PRIMARY KEY,
    Name VARCHAR(100) NOT NULL,
    Team VARCHAR(50) NOT NULL,
    Height DECIMAL(5,2) CHECK (Height > 0),
    Birthday DATE,
    PlayedMatches INT DEFAULT 0,
    FOREIGN KEY (Team) REFERENCES TEAM(TeamName)
);

-- Create MATCH table (MATCH is a reserved keyword)
CREATE TABLE [MATCH] (  -- Use brackets for reserved keyword
    MatchId INT PRIMARY KEY,
    MatchDate DATE NOT NULL,
    Team1 VARCHAR(50) NOT NULL,
    Team2 VARCHAR(50) NOT NULL,
    WonSetsTeam1 INT DEFAULT 0 CHECK (WonSetsTeam1 >= 0),
    WonSetsTeam2 INT DEFAULT 0 CHECK (WonSetsTeam2 >= 0),
    Referee VARCHAR(100),
    FOREIGN KEY (Team1) REFERENCES TEAM(TeamName),
    FOREIGN KEY (Team2) REFERENCES TEAM(TeamName),
    CONSTRAINT CHK_DifferentTeams CHECK (Team1 <> Team2)
);

-- Create PLAYED table
CREATE TABLE PLAYED (
    MatchId INT NOT NULL,
    PlayerId INT NOT NULL,
    Role VARCHAR(30),
    ScoredPoints INT DEFAULT 0,
    PRIMARY KEY (MatchId, PlayerId),
    FOREIGN KEY (MatchId) REFERENCES [MATCH](MatchId),
    FOREIGN KEY (PlayerId) REFERENCES PLAYER(PlayerId)
);

