    StudentID VARCHAR(20) NOT NULL,
    AppDate DATE NOT NULL,
    AppState VARCHAR(20) NOT NULL,
    PRIMARY KEY (StudentID, AppDate),
    CONSTRAINT CHK_AppState CHECK (AppState IN ('Pending', 'Approved', 'Rejected'))
