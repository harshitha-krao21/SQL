-- Create Students table
CREATE TABLE Students (
    StudentID INT PRIMARY KEY IDENTITY(1,1),
    StudentName VARCHAR(100) NOT NULL,
    SSN CHAR(11) NOT NULL UNIQUE,
    Gender CHAR(1) NOT NULL,
    Email VARCHAR(100) NOT NULL UNIQUE,
    
    -- StudentName constraint: "FirstName,LastName" format
    CONSTRAINT CHK_StudentName_Format CHECK (
        StudentName LIKE '%,%'  -- Contains comma
        AND LEN(SUBSTRING(StudentName, 1, CHARINDEX(',', StudentName) - 1)) >= 3  -- First ≥ 3
        AND LEN(SUBSTRING(StudentName, CHARINDEX(',', StudentName) + 1, 100)) >= 2  -- Last ≥ 2
    ),
    
    -- SSN constraint: ***-**-**** format
    CONSTRAINT CHK_SSN_Format CHECK (
        LEN(SSN) = 11 
        AND SSN LIKE '[0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9]'
    ),
    
    -- Gender constraint: Only M or F
    CONSTRAINT CHK_Gender_Values CHECK (Gender IN ('M', 'F')),
    
    -- Email constraint: Proper format with validation
    CONSTRAINT CHK_Email_Valid CHECK (
        Email LIKE '%_@_%._%'  -- Basic email pattern
        AND CHARINDEX('@', Email) >= 6  -- At least 5 chars before @
        AND CHARINDEX('.', Email) > CHARINDEX('@', Email) + 3  -- Domain name ≥ 3 chars
        AND PATINDEX('%[@#$%^]%', LEFT(Email, CHARINDEX('@', Email) - 1)) = 0  -- No special chars
    )
);

