-- 1. Create states reference table (for data consistency)
CREATE TABLE states (
    state_id INT PRIMARY KEY,
    state_code CHAR(2) UNIQUE NOT NULL,
    state_name VARCHAR(50) NOT NULL
);

-- 2. Create specialties table
CREATE TABLE specialties (
    specialty_id INT PRIMARY KEY,
    specialty_name VARCHAR(100) NOT NULL UNIQUE
);

-- 3. Create addresses table
CREATE TABLE addresses (
    address_id INT PRIMARY KEY,
    street_number VARCHAR(20),
    street_direction VARCHAR(10),
    street_name VARCHAR(100),
    street_type VARCHAR(20),
    city VARCHAR(100) NOT NULL,
    state_id INT NOT NULL,
    zip VARCHAR(10) NOT NULL,
    FOREIGN KEY (state_id) REFERENCES states(state_id)
);

-- 4. Create providers table (main table)
CREATE TABLE providers (
    provider_id INT PRIMARY KEY,
    first_name VARCHAR(50),
    middle_name VARCHAR(50),
    last_name VARCHAR(50) NOT NULL,
    date_of_birth DATE NOT NULL,
    gender CHAR(1) CHECK (gender IN ('M', 'F', 'O')), -- M=Male, F=Female, O=Other
    specialty_id INT,
    address_id INT,
    FOREIGN KEY (specialty_id) REFERENCES specialties(specialty_id),
    FOREIGN KEY (address_id) REFERENCES addresses(address_id)
);

-- 5. Create phone numbers table (providers can have multiple phones)
CREATE TABLE provider_phones (
    phone_id INT PRIMARY KEY,
    provider_id INT NOT NULL,
    phone_number VARCHAR(10) NOT NULL CHECK (
        LEN(phone_number) = 10 
        AND phone_number NOT LIKE '%[^0-9]%'
    ),
    phone_type VARCHAR(20) DEFAULT 'Primary',
    FOREIGN KEY (provider_id) REFERENCES providers(provider_id)
);


