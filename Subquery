--6)Write a query in SQL to list the employees of grade 3 and 4 working in the department of FINANCE or AUDIT and whose salary is more than the salary of 
--ADELYN and experience is more than FRANK. List the result in the ascending order of experience. 

SELECT e.*
FROM employees e
JOIN department d
  ON e.dep_id = d.dep_id
JOIN salgrade s
  ON e.salary BETWEEN s.losal AND s.hisal
WHERE s.grade IN (3, 4)
  AND d.dep_name IN ('FINANCE', 'AUDIT')
  AND e.salary >
      (SELECT salary FROM employees WHERE emp_name = 'ADELYN')
  AND DATEDIFF(DAY, e.hire_date, GETDATE()) >
      (SELECT DATEDIFF(DAY, hire_date, GETDATE())
       FROM employees
       WHERE emp_name = 'FRANK')
ORDER BY DATEDIFF(DAY, e.hire_date, GETDATE()) ASC;

