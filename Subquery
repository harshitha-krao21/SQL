--3)Write a query in SQL to list the employee ID, name, salary, department name of all the 'MANAGERS' and 'ANALYST' working in SYDNEY, PERTH 
--with an exp more than 5 years without receiving the commission and display the list in ascending order of location. 

SELECT e.emp_id,
       e.emp_name,
       e.salary,
       d.dep_name
FROM employees e
JOIN department d
  ON e.dep_id = d.dep_id
WHERE e.job_name IN ('MANAGER', 'ANALYST')
  AND d.dep_location IN ('SYDNEY', 'PERTH')
  AND DATEDIFF(YEAR, e.hire_date, GETDATE()) > 5
  AND e.commission IS NULL
ORDER BY d.dep_location ASC;


--4)Write a query in SQL to display the employee ID, name, salary, department name, location, department ID, job name of all the employees working at SYDNEY or 
--working in the FINANCE department with an annual salary above 28000, but the monthly salary should not be 3000 or 2800 and who does not works as a MANAGER 
--and whose ID containing a digit of '3' or '7' in 3rd position. List the result in ascending order of department ID and descending order of job name. 

SELECT e.emp_id,
       e.emp_name,
       e.salary,
       d.dep_name,
       d.dep_location,
       e.dep_id,
       e.job_name
FROM employees e
JOIN department d
  ON e.dep_id = d.dep_id
WHERE (d.dep_location = 'SYDNEY'
       OR d.dep_name = 'FINANCE')
  AND e.salary * 12 > 28000
  AND e.salary NOT IN (3000, 2800)
  AND e.job_name <> 'MANAGER'
  AND SUBSTRING(CAST(e.emp_id AS VARCHAR), 3, 1) IN ('3','7')
ORDER BY e.dep_id ASC,
         e.job_name DESC;

