    d.name AS department_name
FROM physician p
JOIN affiliated_with a
    ON p.employeeid = a.physician
JOIN department d
    ON a.department = d.departmentid;

--34)Write a query in SQL to obtain the name of the physicians who are trained for a special treatement. 
SELECT DISTINCT p.name AS physician_name,
       pr.name AS treatment_name
FROM physician p
JOIN trained_in t
ON p.employeeid = t.physician
JOIN procedure pr
ON t.treatment = pr.code;

--35)Write a query in SQL to obtain the name of the physicians with department who are yet to be affiliated. 
SELECT 
    p.name AS physician_name,
    d.name AS department_name
FROM physician p
LEFT JOIN affiliated_with a
    ON p.employeeid = a.physician
LEFT JOIN department d
    ON a.department = d.departmentid
WHERE a.physician IS NULL;


--36)Write a query in SQL to obtain the name of the physicians who are not a specialized physician. 
SELECT name
FROM physician
WHERE position NOT LIKE '%Surgical%'
  AND position NOT LIKE '%Attending%';

--37)Write a query in SQL to obtain the name of the patients with their physicians by whom they got their preliminary treatement. 
SELECT 
    p.name AS patient_name,
    ph.name AS physician_name
FROM patient p
JOIN physician ph
ON p.pcp = ph.employeeid;


--38)Write a query in SQL to find the name of the patients and the number of physicians they have taken appointment. 
SELECT p.name,
       COUNT(DISTINCT a.physician) AS physician_count
FROM patient p
JOIN appointment a
  ON p.ssn = a.patient
GROUP BY p.name;

--39)Write a query in SQL to count number of unique patients who got an appointment for examination room C. 
SELECT COUNT(DISTINCT patient) AS unique_patient_count
FROM appointment
WHERE examinationroom = 'C';

--40)Write a query in SQL to find the name of the patients and the number of the room where they have to go for their treatment. 
SELECT p.name,
       COUNT(DISTINCT a.examinationroom) AS room_count
FROM patient p
JOIN appointment a
  ON p.ssn = a.patient
GROUP BY p.name;


